@onready var press_any_button: Sprite2D = $PressAnyButton


func _ready() -> void:
	animated_sprite_2d.play("default")
	fade_in_overlay.visible = true
	fade_in_overlay.modulate.a = 1.0
	fade_in_timer.start(3.0)
